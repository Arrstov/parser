# Получите на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Минимальное число подписчиков, чтобы считать чат "популярным"
MIN_SUBSCRIBERS=500

# Максимум результатов на одно ключевое слово
RESULTS_PER_KEYWORD=50

# Прокси (если Telegram блокируется провайдером), например:
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:8888
# PROXY_URL=mtproxy://host:port:secret
